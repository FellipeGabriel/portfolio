---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import singleLight from '../assets/photos/single-light.jpg';
import { ui, EMAIL, LINKEDIN, GITHUB, type Lang } from '../data/content';
import { sectionIds } from '../data/sections';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].contact;
const h = ui[lang].hero;
const [user, domain] = EMAIL.split('@');
---
<section id={sectionIds[lang].contact} class="contact field-amber" data-field="amber" aria-labelledby="contact-title">
  <figure class="contact-img projector" data-contact-img>
    <Picture quality={88} src={singleLight} formats={['avif', 'webp']} widths={[600, 1000, 1500, 2000]} sizes="(max-width: 899px) 100vw, 34vw" alt="" loading="lazy" />
  </figure>
  <div class="contact-main">
    <h2 id="contact-title" class="display contact-title" data-fit data-split>{t.heading}</h2>
    <p class="lead">{t.lead}</p>
    <a class="contact-email" href={`mailto:${EMAIL}`}>
      <span>{user}</span><span>@{domain}</span>
    </a>
    <div class="contact-actions" data-copy-group>
      <button class="btn btn-solid copy-btn" type="button" data-copy={EMAIL} data-copied-label={h.copied}>
        <Icon name="copy" class="icon icon-copy" /><Icon name="check" class="icon icon-check" /><span data-copy-text>{h.copy}</span>
      </button>
      <span class="visually-hidden" role="status" data-copy-status></span>
      <a class="btn" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn<Icon name="arrow-up-right" /></a>
      <a class="btn" href={GITHUB} target="_blank" rel="noopener">GitHub<Icon name="arrow-up-right" /></a>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
    padding: clamp(5rem, 14svh, 10rem) var(--pad) clamp(4rem, 10svh, 7rem);
    align-items: end;
  }
  .contact-main {
    grid-column: 1 / span 8;
    grid-row: 1;
    display: grid;
    gap: 1.25rem;
    position: relative;
    z-index: 2;
  }
  .contact-title {
    font-size: clamp(3rem, 12vw, 19rem);
  }
  .contact-email {
    display: flex;
    flex-wrap: wrap;
    font-size: clamp(1.75rem, 4.4vw, 4.75rem);
    font-weight: 800;
    font-variation-settings: 'wdth' 80;
    line-height: 0.98;
    letter-spacing: -0.015em;
    text-decoration: none;
    border-bottom: 4px solid var(--ink);
    padding-bottom: 0.15em;
    width: fit-content;
    max-width: 100%;
    overflow-wrap: anywhere;
    transition: letter-spacing 0.4s var(--ease-out);
  }
  .contact-email:hover {
    letter-spacing: 0.01em;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .copy-btn :global(.icon-check),
  .copy-btn:global(.is-copied) :global(.icon-copy) {
    display: none;
  }
  .copy-btn:global(.is-copied) :global(.icon-check) {
    display: block;
  }
  .contact-img {
    grid-column: 9 / span 4;
    grid-row: 1;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    margin-right: calc(var(--pad) * -1);
    margin-top: calc(clamp(5rem, 14svh, 10rem) * -1);
    margin-bottom: calc(clamp(4rem, 10svh, 7rem) * -1);
    overflow: hidden;
    position: relative;
    background: var(--ink);
  }
  .contact-img :global(picture) {
    flex: 1;
    min-height: 0;
  }
  .contact-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }
  @media (max-width: 899px) {
    .contact {
      min-height: 0;
    }
    .contact-main,
    .contact-img {
      grid-column: 1 / -1;
    }
    .contact-img {
      grid-row: 1;
      margin: calc(clamp(5rem, 14svh, 10rem) * -1) calc(var(--pad) * -1) 1.5rem;
      height: 42svh;
    }
    .contact-main {
      grid-row: 2;
    }
  }
</style>
