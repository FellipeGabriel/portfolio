---
import QRCode from 'qrcode';

interface Props {
  url: string;
  label: string;
  class?: string;
}
const { url, label, class: cls = '' } = Astro.props;
const svg = await QRCode.toString(url, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#1b1d1b', light: '#00000000' },
});
---
<figure class={`qr ${cls}`}>
  <a class="qr-code" href={url} target="_blank" rel="noopener" aria-label={label} set:html={svg} />
  <figcaption class="label qr-label">{label}</figcaption>
</figure>

<style>
  .qr {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .qr-code {
    display: block;
    flex: none;
    width: 7.5rem;
    padding: 0.6rem;
    background: var(--paper);
  }
  .qr-code :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .qr-label {
    max-width: 18ch;
  }
  @media (max-width: 899px) {
    .qr {
      display: none;
    }
  }
</style>
